<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Nullable: existing disputes can remain without any of these. Required-when-X is
         not enforced here, same precedent as 004-add-evidence-observation.xml. -->
    <changeSet id="005-add-dispute-provider-case-details" author="hafiz">
        <addColumn tableName="disputes">
            <column name="provider_dispute_reference" type="TEXT"/>
            <column name="customer_claim" type="TEXT"/>
            <column name="response_due_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
