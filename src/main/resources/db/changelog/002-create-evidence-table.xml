<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Mirrors model.Evidence - size/content-type/description are
         plain @Column with no explicit length, so VARCHAR(255) (the
         Hibernate default) rather than TEXT. -->
    <changeSet id="002-create-evidence-table" author="hafiz">
        <createTable tableName="evidence">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="dispute_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_evidence_dispute"
                             references="disputes(id)"/>
            </column>
            <column name="file_name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="content_type" type="VARCHAR(255)"/>
            <column name="size_bytes" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="uploaded_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_evidence_dispute_id" tableName="evidence">
            <column name="dispute_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
