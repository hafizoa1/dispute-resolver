<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!-- Nullable: existing disputes have no defence text until the merchant saves
         one. Nonblank-when-saving is enforced at the request-validation layer
         (SaveDefenceRequest), not here - same precedent as 004/005. -->
    <changeSet id="006-add-dispute-defence-text" author="hafiz">
        <addColumn tableName="disputes">
            <column name="defence_text" type="TEXT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
